# Server only. Never use EXPO_PUBLIC_ names for these credentials.
SUPABASE_URL=replace-with-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-service-role-key
AZURE_TENANT_ID=replace-with-university-tenant-uuid
AZURE_TENANT_URL=https://login.microsoftonline.com/replace-with-university-tenant-uuid
AZURE_CLIENT_ID=replace-with-azure-application-id
AZURE_CLIENT_SECRET=replace-with-azure-application-secret
OUTLOOK_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
UNIVERSITY_ALLOWED_DOMAINS=replace-with-exact-university-email-domain
OUTLOOK_ALLOWED_ORIGINS=replace-with-exact-expo-web-origin
# Leave blank unless university mail flow strips forged inbound Authentication-Results
# for this authserv-id and inserts its own DMARC verdict. Blank means review-only.
OUTLOOK_TRUSTED_AUTHSERV_ID=
# A separate random secret (at least 32 characters), also stored in Supabase Vault for the scheduler.
OUTLOOK_WORKER_SECRET=

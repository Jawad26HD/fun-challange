{
  "name": "student-hub",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --host localhost",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:native": "expo export --platform android --platform ios --output-dir dist/native"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.29",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~58.0.26",
    "expo-auth-session": "~58.0.19",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "expo-widgets": "~58.0.29",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
